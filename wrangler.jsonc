{
  // Matches the Worker name Cloudflare already detected for this project.
  "name": "codexdubaiom",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "codexdubai.com", "custom_domain": true },
    { "pattern": "www.codexdubai.com", "custom_domain": true }
  ]
}
