# Apache / cPanel hosting (use instead of _redirects)
Options -MultiViews
RewriteEngine On

# Force HTTPS + no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://codexdubai.com%{REQUEST_URI} [L,R=301]

RewriteRule ^$ /en [L,R=301]
RewriteRule ^index\.php$ /en [L,R=301,NC]
RewriteRule ^contact_us\.php$ /en/contact [L,R=301,NC]
RewriteRule ^contact\.php$ /en/contact [L,R=301,NC]
RewriteRule ^about\.php$ /en/agence [L,R=301,NC]
RewriteRule ^portfolio\.php$ /en/realisations [L,R=301,NC]
RewriteRule ^services\.php$ /en/services [L,R=301,NC]
RewriteRule ^fr/?$ /en [L,R=301]
RewriteRule ^fr/(.+)$ /en/$1 [L,R=301]

# Old site (the 2026 SPA) → current pages. New URLs are not in this list.
# Locale-less paths land on English.
RewriteRule ^(fr|en|ar)/devis(\.html)?/?$ /$1/contact [R=301,L,QSA]
RewriteRule ^devis(\.html)?/?$ /en/contact [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/(terms|privacy)(\.html)?/?$ /$1/contact [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/legal/(terms|privacy)(\.html)?/?$ /$1/contact [R=301,L,QSA]
RewriteRule ^(terms|privacy)(\.html)?/?$ /en/contact [R=301,L,QSA]
RewriteRule ^legal/.+ /en/contact [R=301,L,QSA]

RewriteRule ^(fr|en|ar)/services/application-mobile-dubai(\.html)?/?$ /$1/services/developpement-application-mobile-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/services/developpement-logiciel-dubai(\.html)?/?$ /$1/services/logiciel-sur-mesure-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/services/agence-digitale-dubai(\.html)?/?$ /$1/agence [R=301,L,QSA]
RewriteRule ^services/application-mobile-dubai(\.html)?/?$ /en/services/developpement-application-mobile-dubai [R=301,L,QSA]
RewriteRule ^services/developpement-logiciel-dubai(\.html)?/?$ /en/services/logiciel-sur-mesure-dubai [R=301,L,QSA]
RewriteRule ^services/agence-digitale-dubai(\.html)?/?$ /en/agence [R=301,L,QSA]
RewriteRule ^services/(creation-site-web-dubai|cloud-devops-dubai|cybersecurite-dubai)(\.html)?/?$ /en/services/$1 [R=301,L,QSA]

RewriteRule ^(fr|en|ar)/villes/(dubai|oran|constantine)(\.html)?/?$ /$1/blog/agence-web-dubai-oran-constantine [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/villes/[^/]+(\.html)?/?$ /$1/agence [R=301,L,QSA]
RewriteRule ^villes/(dubai|oran|constantine)(\.html)?/?$ /en/blog/agence-web-dubai-oran-constantine [R=301,L,QSA]
RewriteRule ^villes/[^/]+(\.html)?/?$ /en/agence [R=301,L,QSA]

RewriteRule ^(fr|en|ar)/projects/?$ /$1/realisations [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/projects/skoda-factory(\.html)?/?$ /$1/realisations/skoda-imdes [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/projects/(az-fulfillment|ondefoc)(\.html)?/?$ /$1/realisations/$2 [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/projects/[^/]+(\.html)?/?$ /$1/realisations [R=301,L,QSA]
RewriteRule ^projects/?$ /en/realisations [R=301,L,QSA]
RewriteRule ^projects/skoda-factory(\.html)?/?$ /en/realisations/skoda-imdes [R=301,L,QSA]
RewriteRule ^projects/(az-fulfillment|ondefoc)(\.html)?/?$ /en/realisations/$1 [R=301,L,QSA]
RewriteRule ^projects/.+ /en/realisations [R=301,L,QSA]

RewriteRule ^(fr|en|ar)/blog/(creer-application-mobile-dubai-guide|delai-mvp-application-dubai|idea-to-mvp-algiers)(\.html)?/?$ /$1/blog/lancer-application-mobile-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/creer-site-web-professionnel-dubai-2026(\.html)?/?$ /$1/blog/prix-site-web-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/(logiciel-sur-mesure-pme-dubai|build-vs-buy-dubai)(\.html)?/?$ /$1/blog/logiciel-sur-mesure-ou-solution-du-marche [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/brief-projet-digital-dubai(\.html)?/?$ /$1/blog/cahier-des-charges-projet-digital [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/(maintenance-application-dubai-pourquoi|chargily-paiements-apps-dubai)(\.html)?/?$ /$1/services/developpement-application-mobile-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/etudes-de-cas-codex-dubai-2026(\.html)?/?$ /$1/realisations [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/studio-logiciel-vs-agence-web-dubai(\.html)?/?$ /$1/agence [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/comparatif-agences-digitales-dubai-2026(\.html)?/?$ /$1/blog/top-agences-developpement-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/cout-developpement-application-dubai-2026(\.html)?/?$ /$1/blog/agence-developpement-application-mobile-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/(choose-software-partner-dubai|agence-vs-freelance-dubai)(\.html)?/?$ /$1/blog/meilleure-agence-developpement-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/(react-native-dubai-startups|react-native-vs-flutter-dubai|offline-first-mobile-apps)(\.html)?/?$ /$1/blog/application-mobile-native-ou-multiplateforme [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/(cloud-migration-north-africa|ci-cd-algiers-teams)(\.html)?/?$ /$1/services/cloud-devops-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/cybersecurity-sme-dubai(\.html)?/?$ /$1/services/cybersecurite-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/bilingual-product-ux-dubai(\.html)?/?$ /$1/services/design-ui-ux-dubai [R=301,L,QSA]
RewriteRule ^(fr|en|ar)/blog/api-integrations-dubai(\.html)?/?$ /$1/services/logiciel-sur-mesure-dubai [R=301,L,QSA]
RewriteRule ^blog/?$ /en/blog [R=301,L,QSA]
RewriteRule ^blog/(.+)$ /en/blog/$1 [R=301,L,QSA]

# Clean URLs: /en/contact → fr/contact.html, and drop trailing slashes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|js|css|svg|png|jpg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
